# AVEVA OSIsoft PI Web API Configuration
# Copy this file to .env and fill in the details for your PI Server environment

# PI Web API Server Base URL (e.g., https://pisvr.yourcompany.com/piwebapi)
PI_WEB_API_URL=https://mock-pi-server.local/piwebapi

# PI Data Server Name (e.g., PIDATA01)
PI_DATA_SERVER_NAME=PIDATA01

# Authentication Mode: 'basic', 'windows', or 'mock'
# Use 'mock' when running locally without a live PI server
PI_AUTH_MODE=mock

# Credentials (used when PI_AUTH_MODE=basic)
PI_USERNAME=
PI_PASSWORD=

# Security & Network Settings
PI_VERIFY_SSL=false
PI_TIMEOUT_SECONDS=10

# Application Settings
LOG_LEVEL=INFO
DEFAULT_LOOKBACK_HOURS=2
